    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ScreenVoice records your voice only when you choose Record Your Voice, to clone it for speech. The recording stays on this Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ScreenVoice записывает голос, только когда вы выбираете «Записать свой голос», чтобы озвучивать им перевод. Запись остаётся на этом Mac."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ScreenVoice recognizes the words of a voice sample you import, so you don’t have to type them. Recognition runs on this Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ScreenVoice распознаёт слова импортированного образца голоса, чтобы вам не пришлось их набирать. Распознавание идёт на этом Mac."
          }
        }
      }
    }
  },
  "version" : "1.0"
