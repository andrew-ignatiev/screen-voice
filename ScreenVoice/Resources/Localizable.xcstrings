    },
    "The translation will appear here": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевод появится здесь"
          }
        }
      }
    },
    "The voice designer produced no audio. Try another variant.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конструктор голосов не выдал звук. Попробуйте другой вариант."
          }
        }
      }
    },
    "The voice’s reference recording is missing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не найден эталон голоса."
          }
        }
