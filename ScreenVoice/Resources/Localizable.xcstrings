      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавающая панель"
          }
        }
      }
    },
    "For best results, select just the subtitle strip: recognition is faster and more accurate.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше всего выделить только полосу с субтитрами: так распознавание быстрее и точнее."
          }
