          "stringUnit": {
            "state": "translated",
            "value": "Установлена"
          }
        }
      }
    },
    "Language model required": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужна языковая модель"
          }
