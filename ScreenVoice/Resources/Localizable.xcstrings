      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Область %1$lld×%2$lld на дисплее %3$u"
          }
        }
      }
    },
    "Request Permission": {
      "localizations": {
        "ru": {
