{
  "sourceLanguage": "en",
  "strings": {
    "%@ was only partly downloaded.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл %@ загружен не полностью."
          }
        }
      }
    },
    "%lld%%": {
      "shouldTranslate": false
    },
    "Accurate": {
      "comment": "OCR mode",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точная"
          }
        }
      }
    },
    "Analysis rate: %lld fps": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Частота анализа: %lld кадр/с"
          }
        }
      }
    },
    "Apple Translation on this Mac doesn’t support the selected language pair.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная языковая пара не поддерживается Apple Translation на этом Mac."
          }
        }
      }
    },
    "Apple Translation on this Mac doesn’t support “%@ → %@”. Choose another source language in Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Translation на этом Mac не поддерживает перевод «%1$@ → %2$@». Выберите другой исходный язык в настройках."
          }
        }
      }
    },
    "Best installed Russian voice": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучший установленный русский"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "Capture active": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват активен"
          }
        }
      }
    },
    "Capture stopped by the system.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват остановлен системой."
          }
        }
      }
    },
    "Capture stopped by the system: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Захват остановлен системой: %@"
          }
        }
      }
    },
    "Choose Region or Window…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать область/окно…"
          }
        }
      }
    },
    "Choose Window": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать окно"
          }
        }
      }
    },
    "Choose a window or screen region first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала выберите окно или область экрана."
          }
        }
      }
    },
    "Clear Queue": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить очередь"
          }
        }
      }
    },
    "Confirm the download in the system dialog. Translation starts working once it finishes.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите загрузку в системном окне. Перевод начнёт работать после её завершения."
          }
        }
      }
    },
    "Couldn’t check translation availability.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить доступность перевода."
          }
        }
      }
    },
    "Couldn’t prepare translation": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить перевод"
          }
        }
      }
    },
    "Custom (not saved)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свой (не сохранён)"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить"
          }
        }
      }
    },
    "Delete Preset": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить пресет"
          }
        }
      }
    },
    "Delete the “%@” preset?": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить пресет «%@»?"
          }
        }
      }
    },
    "Describe the voice in English: timbre, age, accent, manner. The male or female line is added for you.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите голос по-английски: тембр, возраст, акцент, манеру. Строка о мужском или женском голосе добавляется автоматически."
          }
        }
      }
    },
    "Display": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отображение"
          }
        }
      }
    },
    "Don’t speak the name before a colon": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не озвучивать имя перед двоеточием"
          }
        }
      }
    },
    "Download (%@)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить (%@)"
          }
        }
      }
    },
    "Download Model": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузить модель"
          }
        }
      }
    },
    "Downloading language model…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка языковой модели…"
          }
        }
      }
    },
    "Drag to select the subtitle area. Press Esc to cancel.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите область с субтитрами. Esc — отмена."
          }
        }
      }
    },
    "Each variant is a different voice that fits the description. The same variant always sounds the same.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый вариант — другой голос под то же описание. Один и тот же вариант всегда звучит одинаково."
          }
        }
      }
    },
    "Engine": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движок"
          }
        }
      }
    },
    "Entire Main Display": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь главный экран"
          }
        }
      }
    },
    "Error": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка"
          }
        }
      }
    },
    "Error: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка: %@"
          }
        }
      }
