      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название"
          }
        }
      }
    },
    "Narrator, female": {
      "comment": "Built-in voice preset",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктор, женский"
          }
        }
      }
    },
    "Narrator, male": {
      "comment": "Built-in voice preset",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диктор, мужской"
          }
        }
      }
    },
    "No Russian voice installed": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Русский голос не установлен"
          }
        }
      }
    },
    "No screen recording permission. Turn on ScreenVoice in System Settings → Privacy & Security → Screen & System Audio Recording.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет разрешения на запись экрана. Включите ScreenVoice в «Системные настройки → Конфиденциальность и безопасность → Запись экрана и системного звука»."
          }
        }
      }
    },
    "Not selected": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не выбран"
          }
        }
      }
    },
