      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас"
          }
        }
      }
    },
    "OCR mode": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим OCR"
          }
        }
      }
    },
    "OCR: %lld ms · lines: %lld": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR: %1$lld мс · строк: %2$lld"
          }
        }
      }
    },
    "Open ScreenVoice": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть ScreenVoice"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки"
          }
        }
      }
    },
    "Open Spoken Content Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки устного контента"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть Системные настройки"
          }
        }
      }
    },
    "Open System Settings → Accessibility → Spoken Content → System Voice → Manage Voices… and download a Russian voice, for example Milena.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Системные настройки → Универсальный доступ → Устный контент → Системный голос → Управление голосами…» и загрузите русский голос, например Milena."
          }
        }
      }
    },
    "Or an App Window": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Или окно приложения"
          }
        }
      }
    },
    "Pause": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза"
          }
        }
      }
    },
    "Paused": {
      "comment": "Status: capture is paused",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пауза"
          }
        }
      }
    },
    "Preview": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прослушать"
          }
        }
      }
    },
    "Quit ScreenVoice": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти"
          }
        }
      }
    },
    "Qwen3-TTS (neural)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Qwen3-TTS (нейросеть)"
          }
        }
      }
    },
    "Qwen3-TTS model not downloaded": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель Qwen3-TTS не загружена"
          }
        }
      }
    },
    "Qwen3-TTS voice unavailable: %@ Using the system voice.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голос Qwen3-TTS недоступен: %@ Используется системный голос."
          }
        }
      }
    },
    "Ready": {
      "comment": "Qwen model state",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готова"
          }
        }
      }
    },
    "Recognition": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание"
          }
        }
      }
    },
    "Recognition error: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка распознавания: %@"
          }
        }
      }
    },
    "Recognition, translation and speech run on this Mac. Frames and text are never saved to disk or sent anywhere.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание, перевод и озвучка выполняются на этом Mac. Кадры и текст не сохраняются на диск и никуда не отправляются."
          }
        }
      }
    },
    "Recognizing": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание"
          }
        }
      }
    },
    "Refresh window list": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновить список окон"
          }
        }
      }
    },
